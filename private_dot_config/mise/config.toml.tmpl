{{/* .tmpl suffix stops mise loading this chezmoi source copy as a project config when cwd is under private_dot_config */ -}}
[tools]
bun = "latest"
node = ["latest", "24", "22"]
python = ["latest", "3.12", "3.11", "3.10"]
ruff = "latest"
"npm:pyright" = "latest"
"npm:typescript" = "latest"
"npm:vscode-langservers-extracted" = "latest"
"npm:typescript-language-server" = "latest"
"npm:yaml-language-server" = "latest"
"npm:bash-language-server" = "latest"
"npm:dockerfile-language-server-nodejs" = "latest"
"npm:prettier" = "latest"
"npm:@agentclientprotocol/claude-agent-acp" = "latest"
"pypi:black" = "latest"

[settings]
idiomatic_version_file_enable_tools = []

[settings.self_update]
auto = true

# npm: tools install through bun instead of npm
[settings.npm]
package_manager = "bun"

[settings.node]
compile = false
gpg_verify = false

[settings.python]
compile = false

