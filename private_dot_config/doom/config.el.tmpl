;;; $DOOMDIR/config.el -*- lexical-binding: t; -*-

{{ if and .theme.noctalia (lookPath "noctalia") -}}
;; noctalia writes themes/noctalia-theme.el on first run; fall back until it exists
(setq doom-theme (if (file-exists-p (expand-file-name "themes/noctalia-theme.el" doom-user-dir))
                     'noctalia
                   '{{ .theme.fallback.doom }}))
{{- else -}}
(setq doom-theme '{{ .theme.fallback.doom }})
{{- end }}

(setq display-line-numbers-type (quote relative))

(setq org-directory "~/org/")

{{ if eq .chezmoi.os "linux" -}}
;; system has "Symbols Nerd Font", not the "...Mono" variant nerd-icons expects
(setq nerd-icons-font-family "Symbols Nerd Font")
{{ end }}

(after! treemacs
  (treemacs-follow-mode 1))

(setq ghostel-module-auto-install (quote download))

;; language servers installed via mise
(let ((shims (expand-file-name "~/.local/share/mise/shims")))
  (when (file-directory-p shims)
    (add-to-list 'exec-path shims)
    (setenv "PATH" (concat shims ":" (getenv "PATH")))))
