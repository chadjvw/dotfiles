#!/usr/bin/env bash
# Latest cli tools, editors, eternal terminal, and emacs for Linux without them packaged. Rechecked monthly: {{ now | date "2006-01" }}
set -euo pipefail

prefix="$HOME/.local"
pm=$(command -v dnf || command -v yum)
mkdir -p "$prefix/bin"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# mise: installed by hand since everything below falls back to it
export PATH="$HOME/.cargo/bin:$prefix/bin:$HOME/.local/share/mise/shims:$PATH"
command -v mise >/dev/null || curl -fsSL https://mise.run | sh

# rustup isn't in the mise registry; shell rc files already put ~/.cargo/bin on PATH
if ! command -v rustup >/dev/null; then
  curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi
rustup component add rust-analyzer

# tools: anything not already on PATH comes from dnf when it has the package, otherwise mise.
# mise tools go in a conf.d file so they don't fight the chezmoi-managed mise config.
tools=(
  # binary              dnf package     mise tool
  "hx                   helix           helix"
  "fish                 fish            github:fish-shell/fish-shell"
  "starship             starship        starship"
  "zoxide               zoxide          zoxide"
  "atuin                atuin           cargo:atuin"
  "usage                usage           usage"
  "tmux                 tmux            tmux"
  "zellij               zellij          zellij"
  "eza                  eza             eza"
  "bat                  bat             bat"
  "fd                   fd-find         fd"
  "rg                   ripgrep         ripgrep"
  "sd                   sd              sd"
  "duf                  duf             duf"
  "tldr                 tealdeer        tealdeer"
  "tokei                tokei           tokei"
  "delta                git-delta       delta"
  "difft                difftastic      difftastic"
  "cargo-nextest        cargo-nextest   cargo:cargo-nextest"
  "cargo-install-update cargo-update    cargo:cargo-update"
  "cargo-cache          cargo-cache     cargo:cargo-cache"
  "uv                   uv              uv"
  "topgrade             topgrade        topgrade"
  "rgrc                 rgrc            cargo:rgrc"
)
missing=()
for t in "${tools[@]}"; do
  read -r bin _ _ <<<"$t"
  command -v "$bin" >/dev/null || missing+=("$t")
done
if [ ${#missing[@]} -gt 0 ]; then
  names=()
  for t in "${missing[@]}"; do
    read -r _ pkg _ <<<"$t"
    names+=("$pkg")
  done
  # cache-only: a non-root metadata refresh can hang on an unreachable repo
  available=" $("$pm" -q -C repoquery --qf '%{name}\n' "${names[@]}" 2>/dev/null | tr '\n' ' ') "

  dnf_pkgs=()
  mise_tools=()
  for t in "${missing[@]}"; do
    read -r _ pkg tool <<<"$t"
    if [[ $available == *" $pkg "* ]]; then
      dnf_pkgs+=("$pkg")
    else
      mise_tools+=("$tool@latest")
    fi
  done

  [ ${#dnf_pkgs[@]} -eq 0 ] || sudo "$pm" install -y "${dnf_pkgs[@]}"
  if [ ${#mise_tools[@]} -gt 0 ]; then
    # cargo: tools build from source
    [[ " ${mise_tools[*]}" != *" cargo:"* ]] || sudo "$pm" install -y gcc make perl openssl-devel
    mkdir -p "$HOME/.config/mise/conf.d"
    mise use --path "$HOME/.config/mise/conf.d/local.toml" "${mise_tools[@]}"
  fi
fi

# eternal terminal: dnf when it has it, otherwise build the latest release (no linux binaries, no mise tool)
stamp="$prefix/share/eternalterminal/version"
if ! rpm -q et >/dev/null 2>&1; then
  if [ ! -e "$stamp" ] && "$pm" -q -C repoquery --qf '%{name}\n' et 2>/dev/null | grep -qx et; then
    sudo "$pm" install -y et
  else
    tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/MisterTea/EternalTerminal/releases/latest)
    tag=${tag##*/}
    if [ "$(cat "$stamp" 2>/dev/null)" != "$tag" ]; then
      sudo "$pm" install -y cmake gcc-c++ git libsodium-devel protobuf-devel protobuf-compiler \
        openssl-devel zlib-devel libunwind-devel libutempter-devel libatomic
      # submodules aren't in the release tarball
      git clone -q --depth 1 --branch "$tag" --recurse-submodules --shallow-submodules \
        https://github.com/MisterTea/EternalTerminal.git "$tmp/et"
      cmake -S "$tmp/et" -B "$tmp/et/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$prefix" \
        -DDISABLE_VCPKG=ON -DBUILD_TESTING=OFF -DDISABLE_TELEMETRY=ON
      cmake --build "$tmp/et/build" -j"$(nproc)"
      cmake --install "$tmp/et/build" --strip
      # the et client runs etterminal over non-interactive ssh, which doesn't see ~/.local/bin
      sudo ln -sfn "$prefix/bin/etterminal" /usr/local/bin/etterminal
      mkdir -p "${stamp%/*}"
      echo "$tag" >"$stamp"
    fi
  fi
fi

# emacs: terminal-only build from the gnu ftp with tree-sitter, only when a newer release exists
latest=$(curl -fsSL https://ftp.gnu.org/gnu/emacs/ | grep -o 'emacs-[0-9][0-9.]*\.tar\.xz' | sort -uV | tail -1)
ver=${latest#emacs-}
ver=${ver%.tar.xz}
installed=$("$prefix/bin/emacs" --version 2>/dev/null | sed -n '1s/.* //p' || true)
if [ "$installed" != "$ver" ]; then
  sudo "$pm" install -y gcc make ncurses-devel gnutls-devel libxml2-devel jansson-devel texinfo

  # libtree-sitter isn't packaged here; build the latest release
  ts=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/tree-sitter/tree-sitter/releases/latest)
  ts=${ts##*/}
  curl -fsSL "https://github.com/tree-sitter/tree-sitter/archive/refs/tags/$ts.tar.gz" | tar -xz -C "$tmp"
  make -C "$tmp/tree-sitter-${ts#v}" -j"$(nproc)" PREFIX="$prefix" install

  curl -fsSL "https://ftp.gnu.org/gnu/emacs/$latest" | tar -xJ -C "$tmp"
  cd "$tmp/emacs-$ver"
  PKG_CONFIG_PATH="$prefix/lib/pkgconfig" LDFLAGS="-Wl,-rpath,$prefix/lib" \
    ./configure --prefix="$prefix" --without-x --without-ns --without-native-compilation --with-gnutls --with-tree-sitter
  make -j"$(nproc)"
  make install
fi
